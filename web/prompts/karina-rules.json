{
  "version": 1,
  "format": {
    "font": "Times New Roman",
    "sizePt": 12,
    "titleNote": "Title can be either 14pt or 16pt",
    "alignment": "justified",
    "lineSpacing": 1.5,
    "minLineSpacing": 1.15,
    "margins": "1 inch (2.54 cm) on all sides",
    "pageNumber": "Bottom center or bottom right",
    "autoFix": [
      "Study Plan",
      "Autobiography",
      "Personal Statement",
      "Statement of Purpose",
      "Essay"
    ],
    "reminderTitle": "ALWAYS REMEMBER BASIC WRITING FORMAT"
  },
  "builtIn": {
    "hiddenCharacters": {
      "enabled": true
    },
    "degreeCase": {
      "enabled": true
    },
    "spaceBeforeColon": {
      "enabled": true
    },
    "doubleSpace": {
      "enabled": true
    },
    "hyphenCompounds": {
      "enabled": true
    },
    "indonesianUniversity": {
      "enabled": true
    },
    "indonesianAcronyms": {
      "enabled": true
    },
    "universityAcronyms": {
      "enabled": true
    },
    "headerBlock": {
      "enabled": true,
      "titles": {
        "Study Plan": "STUDY PLAN",
        "Autobiography": "AUTOBIOGRAPHY",
        "Personal Statement": "PERSONAL STATEMENT",
        "Statement of Purpose": "STATEMENT OF PURPOSE",
        "Essay": "ESSAY"
      }
    },
    "conclusionHeading": {
      "enabled": true,
      "note": "no need to write the title “{heading}”. It is not a report, but your personal {doctype}"
    },
    "longParagraph": {
      "enabled": false,
      "maxSentences": 10,
      "note": "the paragraph is too long, shorten it! 1 paragraph min. 3 sentences, max 5-6 sentences"
    },
    "resumeYear": {
      "enabled": true,
      "note": "put the year"
    },
    "resumeLanguage": {
      "enabled": true,
      "note": "how’s the level"
    },
    "endNote": {
      "enabled": true,
      "heading": "Note:"
    },
    "lengthCheck": {
      "enabled": true,
      "limits": [
        {
          "docType": "Study Plan",
          "maxWords": 1100,
          "message": "Please check again the max required pages for the study plan in the guidebook. If not mentioned, usually 2-3 pages (4 pages max) or around 1000 words. This one is around {pages} pages ({words} words), try to make it shorter, compact and straight forward."
        },
        {
          "docType": "Autobiography",
          "maxWords": 850,
          "message": "Usually, autobio consists of only 1-2 pages. This one is around {pages} pages, if you can shorten it into 2 pages, it will be good."
        },
        {
          "docType": "Personal Statement",
          "maxWords": 850,
          "message": "Please check in the guidebook about the number of pages or words. If not mentioned, try to make it into 2 pages max."
        },
        {
          "docType": "Statement of Purpose",
          "maxWords": 850,
          "message": "Please check in the guidebook about the number of pages or words. If not mentioned, try to make it into 2 pages max."
        }
      ],
      "withinMessage": "Please check in the guidebook whether they specified certain limitation of pages or words. If not, you can proceed."
    },
    "essayLimit": {
      "enabled": true,
      "message": "The {ordinal} essay exceeds the max words of {limit}. Please check again, I found it is around {words} words."
    },
    "paragraphBalance": {
      "enabled": true,
      "message": "Try to balance the number of sentences in each paragraph, I found some paragraphs are very long but others are just 1-2 sentences. For each paragraph, try to write min. 3 sentences and max 5-6 sentences."
    },
    "listsAndTables": {
      "enabled": true,
      "message": "It is better to make narrative paragraphs rather than bullet points or tables, could save you more space and feel more personal."
    },
    "tooManySections": {
      "enabled": true,
      "minSections": 6,
      "message": "Does the university ask you to make it into {sections} points? Try to make it shorter, only into 3-4 points max."
    }
  },
  "grammar": {
    "Agreement": "style",
    "Grammar": "style",
    "Spelling": "style",
    "Redundancy": "style",
    "Miscellaneous": "extra",
    "Eggcorn": "extra",
    "Malapropism": "extra",
    "Usage": "extra",
    "Capitalization": "extra",
    "Style": "off",
    "WordChoice": "off"
  },
  "custom": [
    {
      "id": "default-1",
      "enabled": true,
      "docTypes": [
        "CV/Resume"
      ],
      "find": "",
      "match": "words",
      "caseSensitive": false,
      "occurrences": "first",
      "condition": "always",
      "words": 0,
      "label": "CV: ask for the university's resume guidelines",
      "action": "end-note",
      "text": "Could you send me the guidelines from the uni for the resume? If not, try to make it with Resume builder with ATS Friendly Concept."
    },
    {
      "id": "default-2",
      "enabled": true,
      "docTypes": [
        "Study Plan"
      ],
      "find": "first year; first-year; second year; second-year; 1st year; 1st-year; 2nd year; 2nd-year; year 1; year1; year 2; year2; first semester; second semester; 1st semester; 2nd semester",
      "match": "words",
      "caseSensitive": false,
      "occurrences": "first",
      "condition": "missing",
      "words": 0,
      "label": "Study plan: ask for the 1st and 2nd year plan",
      "action": "end-note",
      "text": "What are you going to do during your studies? 1st year, 2nd year, you must put in detail to convince the committee that you have good preparation."
    },
    {
      "id": "default-3",
      "enabled": true,
      "docTypes": [
        "Study Plan",
        "Autobiography",
        "Personal Statement",
        "Statement of Purpose"
      ],
      "find": "Taiwan",
      "match": "phrase",
      "caseSensitive": false,
      "occurrences": "first",
      "condition": "missing",
      "words": 0,
      "label": "Ask “Why Taiwan?” when Taiwan is never mentioned",
      "action": "end-note",
      "text": "Why Taiwan? You didn’t mention why you chose Taiwan. What motivates you to pursue a degree in Taiwan?"
    },
    {
      "id": "default-4",
      "enabled": true,
      "docTypes": [
        "Study Plan",
        "Personal Statement",
        "Statement of Purpose"
      ],
      "find": "future; career; after graduation; after graduating; after I graduate; after graduate; after completing; after finishing; long-term; long term; short-term; short term",
      "match": "words",
      "caseSensitive": false,
      "occurrences": "first",
      "condition": "missing",
      "words": 0,
      "label": "Ask about the future plan",
      "action": "end-note",
      "text": "How’s your plan in the future? How will studying this major help you to find a suitable career or job?"
    },
    {
      "id": "default-5",
      "enabled": true,
      "docTypes": [],
      "find": "your university; your campus",
      "match": "words",
      "caseSensitive": false,
      "occurrences": "first",
      "condition": "always",
      "words": 0,
      "label": "“your university” → ask for the real university name",
      "action": "note",
      "text": "mention the university name, example: at National Taiwan University (NTU)"
    },
    {
      "id": "default-6",
      "enabled": true,
      "docTypes": [],
      "find": "",
      "match": "words",
      "caseSensitive": false,
      "occurrences": "first",
      "condition": "always",
      "words": 0,
      "label": "Change contraction words",
      "action": "ai",
      "text": "Add a suggestion to change contractions to their full forms.\nWhile writing a formal document, it is preferred to use a full form word instead of shorten/contracted form.\nFor example, instead of I'm, it should be I am; he's should be he is; didn't should be did not; can't should be cannot, etc."
    }
  ],
