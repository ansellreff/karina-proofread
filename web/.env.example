# TEMPLATE ONLY - this file is committed to git. Put real values in .env.local (never committed),
# and the same names in Vercel (Project -> Settings -> Environment Variables) for the online app.

# Anthropic API key: Console -> Settings -> Workspaces -> (your workspace) -> API keys -> Create key.
# A key created inside a workspace works as-is; set the workspace's monthly spend limit there too.
ANTHROPIC_API_KEY=

# Only needed for a key that is NOT scoped to a workspace (the API then asks for this header).
# Console -> Settings -> Workspaces -> copy the workspace ID.
ANTHROPIC_WORKSPACE_ID=

# --- Microsoft sign-in + OneDrive (docs/ONLINE_SETUP.md). Leave MS_CLIENT_ID empty to run locally without sign-in. ---
# Entra admin center -> App registrations -> Karina Proofread -> Overview: "Application (client) ID"
MS_CLIENT_ID=
# ... -> Certificates & secrets -> New client secret: the "Value" (shown once)
MS_CLIENT_SECRET=
# A long random string that encrypts the sign-in cookie (at least 32 characters; a different one online)
AUTH_SECRET=
# The Microsoft account allowed to sign in (comma-separate several)
ALLOWED_ACCOUNT=
# The app's address, e.g. https://karina-proofread.vercel.app (locally: http://localhost:3000)
APP_URL=
